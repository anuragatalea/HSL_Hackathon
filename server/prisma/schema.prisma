datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TaskStatus {
  SCHEDULED
  READY
  ASSIGNED
  DISPATCHED
  EN_ROUTE
  ARRIVED
  AWAITING_CONFIRMATION
  SNOOZED
  RETRY_PENDING
  COMPLETED
  STAFF_ATTENTION_REQUIRED
  CANCELLED
  FAILED
}

enum RoverStatus {
  IDLE
  MOVING
  ARRIVED
  WAITING
  RETURNING
  CHARGING
  OFFLINE
  ESTOP
}

enum UserRole {
  ADMIN
  NURSE
  CAREGIVER
  STAFF
}

enum ActorType {
  SYSTEM
  CAREGIVER
  RESIDENT
  ROVER
}

model Resident {
  id             String               @id @default(uuid())
  name           String
  roomNumber     String
  notes          String?
  photoUrl       String?
  faceEmbeddings Json?                // 128D Float Vector or multi-pose cluster
  isEnrolled     Boolean              @default(false)
  enrolledAt     DateTime?
  schedules      RoverSchedule[]
  tasks          RoverTask[]
  assistanceReqs ResidentAssistance[]
  activities     Activity[]
  healthLogs     HealthLog[]
  mediaAssets    MediaAsset[]
  createdAt      DateTime             @default(now())
}

model Room {
  id        String   @id @default(uuid())
  number    String   @unique
  name      String
  waypointX Float
  waypointY Float
  zone      String   @default("RESIDENT_WING")
}

model RoverDevice {
  id           String      @id @default(uuid())
  name         String      @unique
  status       RoverStatus @default(IDLE)
  batteryLevel Int         @default(100)
  currentRoom  String?
  currentX     Float       @default(0.0)
  currentY     Float       @default(0.0)
  lastSeenAt   DateTime    @default(now())
  isActive     Boolean     @default(true)
  tasks        RoverTask[]
}

model RoverSchedule {
  id                String      @id @default(uuid())
  residentId        String
  resident          Resident    @relation(fields: [residentId], references: [id])
  roomId            String
  itemName          String
  medications       Json?       // Array of { name, dose, instructions, compartment }
  scheduledTime     String      // e.g. "10:00" or "11:00"
  frequency         String      @default("ONCE")
  assignedStaffId   String
  roverId           String
  maxAttempts       Int         @default(3)
  snoozeDurationMin Int         @default(10)
  isActive          Boolean     @default(true)
  tasks             RoverTask[]
  createdAt         DateTime    @default(now())
}

model RoverTask {
  id            String             @id @default(uuid())
  scheduleId    String?
  schedule      RoverSchedule?     @relation(fields: [scheduleId], references: [id])
  residentId    String
  resident      Resident           @relation(fields: [residentId], references: [id])
  roomId        String
  roverId       String
  rover         RoverDevice        @relation(fields: [roverId], references: [id])
  medications   Json?              // Array of { name, dose, instructions, compartment }
  status        TaskStatus         @default(SCHEDULED)
  scheduledAt   DateTime
  startedAt     DateTime?
  arrivedAt     DateTime?
  completedAt   DateTime?
  attemptCount  Int                @default(0)
  snoozedUntil  DateTime?
  failureReason String?
  attempts      RoverTaskAttempt[]
  auditLogs     RoverAuditLog[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model RoverTaskAttempt {
  id            String    @id @default(uuid())
  taskId        String
  task          RoverTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attemptNumber Int
  startedAt     DateTime  @default(now())
  arrivedAt     DateTime?
  completedAt   DateTime?
  result        String    // SUCCESS, SNOOZED, ESCALATED, FAILED
  reason        String?
  notes         String?
}

model RoverAuditLog {
  id        String     @id @default(uuid())
  taskId    String?
  task      RoverTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actorType ActorType
  actorId   String
  event     String
  metadata  Json?
  createdAt DateTime   @default(now())
}

model ResidentAssistance {
  id             String    @id @default(uuid())
  residentId     String
  resident       Resident  @relation(fields: [residentId], references: [id])
  roomId         String
  requestType    String    @default("GENERAL_ASSISTANCE")
  status         String    @default("PENDING")
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(CAREGIVER)
  badgeId      String?
  avatarUrl    String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Activity {
  id          String    @id @default(uuid())
  residentId  String
  resident    Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)
  type        String    // MEAL, EXERCISE, MEDICATION, SOCIAL, VISION_DETECTION, CHECK_IN
  title       String
  notes       String?
  loggedBy    String    @default("System")
  timestamp   DateTime  @default(now())
  createdAt   DateTime  @default(now())
}

model HealthLog {
  id          String    @id @default(uuid())
  residentId  String
  resident    Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)
  systolic    Int?
  diastolic   Int?
  heartRate   Int?
  bloodSugar  Float?
  temperature Float?
  oxygenLevel Int?
  notes       String?
  loggedBy    String    @default("Staff")
  timestamp   DateTime  @default(now())
  createdAt   DateTime  @default(now())
}

model MediaAsset {
  id          String    @id @default(uuid())
  residentId  String?
  resident    Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)
  url         String
  s3Key       String?
  type        String    @default("PHOTO") // PHOTO, VIDEO, DOCUMENT
  caption     String?
  source      String    @default("KIOSK") // KIOSK, ROVER_CAMERA, UPLOAD
  createdAt   DateTime  @default(now())
}

