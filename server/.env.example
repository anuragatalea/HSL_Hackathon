# Database Connection String
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hsl_rover?schema=public"

# Backend Server Port (4000 avoids conflict with UGV-Beast port 5000)
PORT=4000

# Rover Operation Mode: SIMULATION or HARDWARE
ROVER_MODE=SIMULATION

# Demo Fast-Forward: Compress 10-minute snooze to N seconds for live judging
FAST_FORWARD_SECONDS=10

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Staff JWT Authentication
JWT_SECRET=hsl-care-smart-rover-jwt-secret-key-2026

# Optional Cloud Storage (AWS S3) - falls back to local /uploads if omitted
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# S3_BUCKET=your_s3_bucket_name
# AWS_REGION=us-east-1

