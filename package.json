{
  "name": "hackathon-hsl-smart-rover",
  "version": "1.0.0",
  "private": true,
  "description": "HSL Care Smart Rover - Autonomous Delivery & Resident Assistance Platform",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "db:generate": "npm --prefix server run db:generate",
    "db:push": "npm --prefix server run db:push",
    "db:seed": "npm --prefix server run db:seed",
    "db:studio": "npm --prefix server run db:studio",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v && docker compose up --build",
    "release:phase": "node scripts/release-phase.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "hsl-care",
    "rover",
    "robotics",
    "raspberry-pi",
    "react",
    "node",
    "postgres",
    "prisma"
  ],
  "author": "HSL Care Hackathon Team",
  "license": "MIT"
}
